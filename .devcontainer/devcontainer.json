{
	"name": "CS1",
	"build": {
		"dockerfile": "Dockerfile"
	},
	// Use the non-root user created in the Dockerfile
	"remoteUser": "dev",
	"overrideCommand": false,
	"updateRemoteUserUID": true,
	// Useful inside tasks/terminals for scripts that read this var
	"containerEnv": {
		"WORKSPACE_FOLDER": "${containerWorkspaceFolder}"
	},
	// Make elan/lean/lake available in VS Code shells & tasks.
	// IMPORTANT: use the container's HOME, not the host's.
	"remoteEnv": {
		"PATH": "/home/dev/.elan/bin:/home/dev/.local/bin:${containerEnv:PATH}"
	},
	// Persist Claude Code history (~/.claude) across container rebuilds via a
	// named volume. A fresh volume mounts root-owned, so chown it to dev once
	// on create (dev has passwordless sudo). Note: do NOT mount all of
	// /home/dev — an empty volume there would shadow the image-baked ~/.elan
	// and the Claude binary in ~/.local.
	"mounts": [
		"source=cs1-claude,target=/home/dev/.claude,type=volume"
	],
	"postCreateCommand": "sudo chown -R dev:dev /home/dev/.claude",
	"runArgs": [
		"--memory=10gb",
		"--init",
		"--cap-add=SYS_PTRACE",
		"--security-opt",
		"seccomp=unconfined"
	],
	"forwardPorts": [
		3000
	],
	"portsAttributes": {
		"3000": {
			"label": "mdBook",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"python.analysis.typeEvaluation.deprecateTypingAliases": true
			},
			"extensions": [
				// Dev Containers is a UI-only extension: it runs on the host, not
				// in here. Students install it by hand (see src/setup.md, step 1).
				"ms-dotnettools.vscode-dotnet-runtime",
				"formulahendry.auto-close-tag",
				"formulahendry.auto-rename-tag",
				"aaron-bond.better-comments",
				"alefragnani.bookmarks",
				"streetsidesoftware.code-spell-checker",
				"dafny-lang.ide-vscode",
				"usernamehw.errorlens",
				"sleistner.vscode-fileutils",
				"github.vscode-github-actions",
				"github.copilot",
				"github.vscode-pull-request-github",
				"eamodio.gitlens",
				"ecmel.vscode-html-css",
				"oderwat.indent-rainbow",
				"james-yu.latex-workshop",
				"shreyassrinivas.loogle-lean",
				"yzhang.markdown-all-in-one",
				"davidanson.vscode-markdownlint",
				"pkief.material-icon-theme",
				"cardinal90.multi-cursor-case-preserve",
				"zhuangtongfa.material-theme",
				"christian-kohler.path-intellisense",
				"mathematic.vscode-pdf",
				"esbenp.prettier-vscode",
				"ms-python.python",
				"stkb.rewrap",
				"gruntfuggly.todo-tree",
				"redhat.vscode-yaml",
				"ms-python.black-formatter",
				"leanprover.lean4",
				"denis-gorbachev.lean4-code-actions",
				"Anthropic.claude-code",
				"tintinweb.graphviz-interactive-preview",
				"openai.chatgpt"
			]
		}
	}
}
