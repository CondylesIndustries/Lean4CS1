# Single source of truth for pinned tool versions.
# Consumed by:
#   - .devcontainer/Dockerfile   (sourced inside RUN layers)
#   - .github/workflows/mdbook.yml (loaded into $GITHUB_ENV)
# Keep as plain KEY=VALUE lines (no `export`, no interpolation) so both
# `. versions.env` and `grep >> $GITHUB_ENV` work.
YQ_VERSION=4.53.6
GH_VERSION=2.87.2
MDBOOK_VERSION=0.5.4
MDBOOK_TOC_VERSION=0.15.4
MDBOOK_MERMAID_VERSION=0.17.1
ELAN_VERSION=4.2.4
